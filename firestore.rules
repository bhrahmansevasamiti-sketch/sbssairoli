rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.sbssAdmin == true; }
    function isSelf(phone) { return signedIn() && request.auth.token.phone_number == phone; }

    // Member documents are keyed by E.164 mobile number, e.g. +919876543210.
    match /members/{phone} {
      allow read: if isAdmin() || isSelf(phone);
      // Only trusted administrators (custom claim set server-side) can create/update/delete records.
      allow create, update, delete: if isAdmin();
    }
    match /events/{eventId} {
      allow read: if isAdmin() || (signedIn() && resource.data.published == true);
      allow create, update, delete: if isAdmin();
    }
    match /attendance/{recordId} {
      allow read, write: if isAdmin();
    }
    match /contributions/{recordId} {
      allow read: if isAdmin() || (signedIn() && resource.data.memberPhone == request.auth.token.phone_number);
      allow create, update, delete: if isAdmin();
    }
    // Deny all unspecified collections and documents by default.
    match /{document=**} { allow read, write: if false; }
  }
}